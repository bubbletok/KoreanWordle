.loading-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(30, 40, 63);
    opacity: 1;
}

.loading-panel {
    width: 700px;
    align-items: center;
}

.loading-progress {
    width: 100%;
    height: 48px;
    margin-bottom: 20px;
}

.loading-progress .unity-progress-bar__background {
    background-color: rgb(59, 70, 105);
    border-width: 0;
    border-radius: 24px;
}

.loading-progress .unity-progress-bar__progress {
    background-color: rgb(255, 255, 255);
    border-radius: 24px;
}

.loading-progress .unity-progress-bar__title-container {
    justify-content: center;
}

.loading-progress .unity-progress-bar__title {
    color: rgb(30, 30, 30);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.loading-status {
    width: 100%;
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
}
