.popup-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.popup {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
    opacity: 1;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.popup--hidden {
    opacity: 0;
    scale: 0.9 0.9;
}

.popup-panel {
    width: 960px;
    min-height: 1160px;
    background-color: rgb(59, 70, 105);
    border-width: 28px;
    border-color: rgb(30, 40, 63);
    border-radius: 56px;
    padding: 56px;
    flex-direction: column;
    align-items: center;
}

.popup-close-button {
    position: absolute;
    top: 28px;
    right: 28px;
    width: 112px;
    height: 112px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 24px;
    background-color: rgba(255, 255, 255, 0.22);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 56px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
}

.popup-title {
    width: 100%;
    font-size: 88px;
    color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
    white-space: normal;
    margin-top: 24px;
}

.popup-message {
    flex-grow: 1;
    width: 100%;
    font-size: 80px;
    color: rgb(255, 255, 255);
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
}

.popup-button-row {
    width: 100%;
    flex-direction: row;
    justify-content: center;
}

.popup-button {
    height: 152px;
    min-width: 340px;
    margin-left: 20px;
    margin-right: 20px;
    padding-left: 32px;
    padding-right: 32px;
    border-width: 0;
    border-radius: 28px;
    background-color: rgb(255, 255, 255);
    color: rgb(30, 30, 30);
    font-size: 64px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
}

.popup-button:hover {
    background-color: rgb(235, 235, 235);
}

.tutorial-hero {
    align-items: center;
    margin-bottom: 48px;
}

.tutorial-hero-cell {
    width: 220px;
    height: 220px;
    border-radius: 28px;
    background-color: rgb(80, 88, 127);
    justify-content: center;
    align-items: center;
}

.tutorial-hero-row {
    flex-direction: row;
}

.tutorial-hero-cell-small {
    width: 140px;
    height: 140px;
    margin-left: 12px;
    margin-right: 12px;
    border-radius: 24px;
    justify-content: center;
    align-items: center;
}

.tutorial-hero-text {
    font-size: 72px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
}

.tutorial-hero-text-small {
    font-size: 52px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
}

.tutorial-hero-dots {
    flex-direction: row;
    margin-top: 20px;
}

.tutorial-hero-dot {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background-color: rgb(41, 46, 68);
    margin-left: 10px;
    margin-right: 10px;
}

.tutorial-hero-labels {
    flex-direction: row;
    margin-top: 10px;
}

.tutorial-hero-label {
    width: 56px;
    margin-left: 10px;
    margin-right: 10px;
    font-size: 26px;
    color: rgb(210, 213, 224);
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
}

.tutorial-example-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-top: 40px;
}

.tutorial-example-cell {
    width: 150px;
    height: 150px;
    min-width: 150px;
    border-radius: 22px;
    justify-content: center;
    align-items: center;
    margin-right: 28px;
}

.tutorial-example-cell-text {
    font-size: 56px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
}

.tutorial-example-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 32px;
    color: rgb(255, 255, 255);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
}

.tutorial-example-answer {
    margin-top: 16px;
    font-size: 28px;
    color: rgb(210, 213, 224);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
}

.tutorial-color-not-in-word {
    background-color: rgb(228, 97, 92);
}

.tutorial-color-wrong-position {
    background-color: rgb(247, 219, 125);
}

.tutorial-color-correct {
    background-color: rgb(117, 181, 246);
}
