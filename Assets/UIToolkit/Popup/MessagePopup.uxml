<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="/Assets/UIToolkit/Popup/Popup.uss" />
    <ui:VisualElement name="message-popup" class="popup" style="background-color: rgba(0, 0, 0, 0.35);">
        <ui:VisualElement class="popup-panel">
            <ui:Label name="message-label" text="" class="popup-message" />
            <ui:Button name="close-button" text="X" class="popup-close-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
