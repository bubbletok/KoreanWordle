.gameplay-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(41, 46, 68);
    flex-direction: column;
    align-items: center;
}

.gameplay-back-button {
    position: absolute;
    top: 35px;
    left: 35px;
    width: 110px;
    height: 110px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Sprites/BackButton.png?fileID=21300000&guid=03ddcfbe92632704d81e9614ce789f10&type=3#BackButton");
    -unity-background-scale-mode: scale-to-fit;
}

.gameplay-back-button:hover {
    scale: 1.1 1.1;
}

.gameplay-help-button {
    position: absolute;
    top: 35px;
    right: 35px;
    width: 110px;
    height: 110px;
    border-width: 0;
    border-radius: 55px;
    background-color: rgb(80, 88, 127);
    color: rgb(255, 255, 255);
    font-size: 55px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
}

.gameplay-help-button:hover {
    scale: 1.1 1.1;
}

.gameplay-title {
    position: absolute;
    top: 170px;
    left: 0;
    right: 0;
    font-size: 70px;
    color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
}

.gameplay-subtitle {
    position: absolute;
    top: 260px;
    left: 0;
    right: 0;
    font-size: 45px;
    color: rgb(210, 213, 224);
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
}

.cell-grid {
    flex-direction: column;
    align-items: center;
    margin-top: 400px;
}

.cell-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 120px;
}

.gameplay-cell {
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Sprites/Cell.png?fileID=21300000&guid=b30542cd892cba14db124c7f857da940&type=3#Cell");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(80, 88, 127);
    justify-content: center;
    align-items: center;
}

.gameplay-cell-text {
    font-size: 70px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
}

.keyboard {
    flex-direction: column;
    position: absolute;
    bottom: 40px;
    left: 0;
    right: 0;
    padding-left: 12px;
    padding-right: 12px;
}

.keyboard-row {
    flex-direction: row;
    justify-content: center;
}

.key {
    height: 90px;
    min-width: 60px;
    margin: 3px;
    border-width: 0;
    border-radius: 8px;
    background-color: rgb(80, 88, 127);
    color: rgb(255, 255, 255);
    font-size: 36px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/BMJUA_otf.otf?fileID=12800000&guid=5e3d8c9224831014c9c346b3f94ba075&type=3#BMJUA_otf");
}

.key-char {
    flex-grow: 1;
    flex-basis: 0;
}

.key-action {
    flex-grow: 1.5;
    flex-basis: 0;
}

.key-enter {
    flex-grow: 1.5;
    flex-basis: 0;
}
